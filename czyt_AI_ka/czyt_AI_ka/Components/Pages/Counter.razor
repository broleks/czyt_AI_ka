@page "/counter"

<div class="container">
    <div class="pacman-container" style="display:flex;justify-content:center;margin-top:20px;">
        <iframe src="games/pacman.html"
                style="border:none;width:500px;height:360px;border-radius:18px;overflow:hidden;">
        </iframe>
    </div>
</div>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
