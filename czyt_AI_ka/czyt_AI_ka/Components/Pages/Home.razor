@page "/"
@using System.ComponentModel.DataAnnotations
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using czyt_AI_ka.Components.Backend
@using czyt_AI_ka.Components.Backend.Models
@inject UserState UserState
@inject NavigationManager Navigation

<div class="home-layout">
    <section class="home-panel">
        <header>
            <h2>Lista użytkowników</h2>
            <p>Wybierz użytkownika, aby kontynuować pracę.</p>
        </header>

        @if (UserState.Users.Count == 0)
        {
            <div class="empty-state">
                Brak użytkowników. Utwórz nowy profil po prawej stronie.
            </div>
        }
        else
        {
            <div class="user-list">
                @foreach (var user in UserState.Users)
                {
                    var isSelected = UserState.SelectedUser?.Id == user.Id;
                    <div class="user-card @(isSelected ? "selslvm  cected" : string.Empty)">
                        <button class="user-card-select" type="button" @onclick="() => SelectUser(user)">
                            <img src="@user.ImagePath" alt="Zdjęcie użytkownika @user.Name" />
                            <div>
                                <div class="user-name">@user.Name</div>
                                <div class="user-meta">Data urodzenia: @user.DateOfBirth.ToString("dd.MM.yyyy") | @user.Gender</div>
                            </div>
                        </button>
                        <div class="user-actions">
                            <button class="btn btn-primary user-edit" type="button" @onclick="() => StartEditing(user)">
                                Edytuj
                            </button>
                            <button class="btn btn-outline-primary user-results" type="button" @onclick="() => GoToResults(user)">
                                Wyniki
                            </button>
                            <button class="btn btn-danger user-delete" type="button" @onclick="() => RemoveUser(user)">
                                Usuń
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="selection-actions">
                <button class="btn btn-outline-secondary" style="width:100%; margin-bottom:15px" type="button" @onclick="ClearSelection">
                    Odznacz użytkownika
                </button>
            </div>
        }
    </section>

    <section class="home-panel">
        <header>
            <h2>@(IsEditing ? "Edycja użytkownika" : "Nowy użytkownik")</h2>
            <p>@(IsEditing ? "Zaktualizuj dane i zapisz zmiany." : "Uzupełnij dane i wybierz zdjęcie.")</p>
        </header>

        <EditForm Model="newUser" OnValidSubmit="HandleValidSubmit" class="user-form">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label" for="userName">Imię</label>
                <InputText id="userName" class="form-control" @bind-Value="newUser.Name" />
                <ValidationMessage For="() => newUser.Name" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="userBirthDate">Data urodzenia</label>
                <InputDate id="userBirthDate" class="form-control" @bind-Value="newUser.DateOfBirth" />
                <ValidationMessage For="() => newUser.DateOfBirth" />
            </div>

            <div class="mb-3">
                <label class="form-label" for="userGender">Płeć</label>
                <InputSelect id="userGender" class="form-select" @bind-Value="newUser.Gender">
                    <option value="">Wybierz</option>
                    <option value="Dziewczynka">Dziewczynka</option>
                    <option value="Chłopiec">Chłopiec</option>
                    <option value="Inna">Inna</option>
                </InputSelect>
                <ValidationMessage For="() => newUser.Gender" />
            </div>

            <div class="mb-3">
                <label class="form-label">Wybierz zdjęcie</label>
                <div class="avatar-grid">
                    @foreach (var avatar in avatarOptions)
                    {
                        <label class="avatar-option @(newUser.ImagePath == avatar ? "selected" : string.Empty)">
                            <input type="radio" name="avatar" value="@avatar" @onchange="() => newUser.ImagePath = avatar" checked="@(newUser.ImagePath == avatar)" />
                            <img src="@avatar" alt="Avatar użytkownika" />
                        </label>
                    }
                </div>
                <div class="custom-upload">
                    <InputFile OnChange="OnCustomImageSelected" accept="image/*" />
                    <button class="btn btn-outline-danger btn-sm" type="button" @onclick="ClearSelectedImage" disabled="@string.IsNullOrWhiteSpace(newUser.ImagePath)">
                        Usuń zdjęcie
                    </button>
                    @if (!string.IsNullOrWhiteSpace(newUser.ImagePath) && newUser.ImagePath.StartsWith("data:image", StringComparison.Ordinal))
                    {
                        <img class="custom-preview" src="@newUser.ImagePath" alt="Podgląd zdjęcia użytkownika" />
                    }
                </div>
                <ValidationMessage For="() => newUser.ImagePath" />
            </div>

            <button class="btn btn-primary" style="width:100%" type="submit">
                @(IsEditing ? "Zapisz zmiany" : "Utwórz użytkownika")
            </button>
        </EditForm>
    </section>
</div>

@code {
    private readonly string[] avatarOptions =
    {
        "images/icons/chłopiec.png",
        "images/icons/dziewczynka.png",
        "images/icons/kot.png",
        "images/icons/pies.png",
        "images/icons/pingwin.png",
        "images/icons/żółw.png"
    };

    private UserFormModel newUser = new();
    private Guid? editingUserId;

    private bool IsEditing => editingUserId.HasValue;

    protected override void OnInitialized()
    {
        ResetForm();
    }

    private void HandleValidSubmit()
    {
        if (IsEditing)
        {
            var updatedUser = new UserProfile
            {
                Id = editingUserId!.Value,
                Name = newUser.Name.Trim(),
                DateOfBirth = newUser.DateOfBirth,
                Gender = newUser.Gender,
                ImagePath = newUser.ImagePath
            };
            UserState.UpdateUser(updatedUser);
        }
        else
        {
            var user = new UserProfile
            {
                Name = newUser.Name.Trim(),
                DateOfBirth = newUser.DateOfBirth,
                Gender = newUser.Gender,
                ImagePath = newUser.ImagePath
            };
            UserState.AddUser(user);
        }

        ResetForm();
    }

    private void SelectUser(UserProfile user)
    {
        UserState.SelectUser(user.Id);
    }

    private void StartEditing(UserProfile user)
    {
        UserState.SelectUser(user.Id);
        editingUserId = user.Id;
        newUser = new UserFormModel
        {
            Name = user.Name,
            DateOfBirth = user.DateOfBirth,
            Gender = user.Gender,
            ImagePath = user.ImagePath
        };
    }

    private void RemoveUser(UserProfile user)
    {
        if (editingUserId == user.Id)
        {
            ResetForm();
        }

        UserState.RemoveUser(user.Id);
    }

    private void ClearSelection()
    {
        UserState.ClearSelection();
    }

    private void GoToResults(UserProfile user)
    {
        Navigation.NavigateTo($"/reading-results/{user.Id}");
    }

    private async Task OnCustomImageSelected(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        var base64 = Convert.ToBase64String(memoryStream.ToArray());
        newUser.ImagePath = $"data:{file.ContentType};base64,{base64}";
    }

    private void ClearSelectedImage()
    {
        newUser.ImagePath = string.Empty;
    }

    private void ResetForm()
    {
        newUser = new UserFormModel
        {
            DateOfBirth = DateTime.Today.AddYears(-6),
            ImagePath = avatarOptions[0]
        };
        editingUserId = null;
    }

    private class UserFormModel
    {
        [Required(ErrorMessage = "Podaj imię")]
        [MinLength(2, ErrorMessage = "Imię musi mieć co najmniej 2 znaki")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "Podaj datę urodzenia")]
        public DateTime DateOfBirth { get; set; } = DateTime.Today.AddYears(-6);

        [Required(ErrorMessage = "Wybierz płeć")]
        public string Gender { get; set; } = string.Empty;

        [Required(ErrorMessage = "Wybierz zdjęcie")]
        public string ImagePath { get; set; } = string.Empty;
    }
}
