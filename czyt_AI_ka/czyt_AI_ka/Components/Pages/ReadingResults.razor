@page "/results/{UserId:guid}"
@page "/reading-results/{UserId:guid}"
@using System.Globalization
@using czyt_AI_ka.Components.Backend
@using czyt_AI_ka.Components.Backend.Models
@inject UserState UserState
@inject ResultsArchive ResultsArchive
@inject NavigationManager Navigation

<div class="app-screen app-screen-results">
    <div class="app-card results-card">
        <div class="results-header">
            <div>
                <h2>Wyniki @(currentUser is null ? string.Empty : $"({currentUser.Name})")</h2>
                <p>@resultsDescription</p>
            </div>
            <div class="results-actions">
                <select class="form-select results-select" @bind="SelectedView">
                    @foreach (var option in resultOptions)
                    {
                        <option value="@option.View">@option.Label</option>
                    }
                </select>
                <button class="btn btn-secondary" @onclick="Close">Zamknij</button>
            </div>
        </div>

        @if (currentUser is null)
        {
            <div class="alert alert-warning">
                Nie znaleziono wybranego użytkownika. Wróć do strony głównej i wybierz profil ponownie.
            </div>
        }
        else if (CurrentResultsCount == 0)
        {
            <div class="empty-state">
                Brak zapisanych wyników dla tego gracza.
            </div>
        }
        else
        {
            @if (SelectedView == ResultsView.Reading)
            {
                <div class="table-responsive results-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th scope="col">Ilość słów</th>
                                <th scope="col">Czas gry</th>
                                <th scope="col">Słów / minutę</th>
                                <th scope="col">Data rozegranej gry</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in PaginatedReadingResults)
                            {
                                <tr>
                                    <td>@result.WordCount</td>
                                    <td>@FormatDuration(result.GameDuration)</td>
                                    <td>@Math.Round(result.WordsPerMinute)</td>
                                    <td>@result.PlayedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="table-responsive results-table">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th scope="col">Czas rozwiązania</th>
                                <th scope="col">Data rozegranej gry</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in PaginatedDurationResults)
                            {
                                <tr>
                                    <td>@FormatDuration(TimeSpan.FromSeconds(result.DurationSeconds))</td>
                                    <td>@result.PlayedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="results-pagination">
                <button class="btn btn-outline-secondary" @onclick="PreviousPage" disabled="@(currentPage <= 1)">
                    Poprzednia
                </button>
                <span>Strona @currentPage z @TotalPages</span>
                <button class="btn btn-outline-secondary" @onclick="NextPage" disabled="@(currentPage >= TotalPages)">
                    Następna
                </button>
            </div>

            <div class="results-chart">
                <h3>@chartTitle</h3>
                <p class="chart-subtitle">@chartSubtitle</p>

                @if (chartPoints.Count == 0)
                {
                    <div class="empty-state">
                        Brak danych do wykresu.
                    </div>
                }
                else
                {
                    <div class="chart-wrapper">
                        <div class="chart-axis-labels">
                            <span class="axis-label axis-label-y">@chartYAxisLabel</span>
                            <div class="chart-plot-area">
                                <div class="chart-main">
                                    <div class="chart-y-ticks" aria-hidden="true">
                                        @foreach (var tick in chartYAxisTicks)
                                        {
                                            <span>@FormatYAxisTick(tick)</span>
                                        }
                                    </div>
                                    <svg viewBox="0 0 @ChartWidth @ChartHeight" role="img" aria-label="Wykres wyników">
                                        <polyline points="@ChartPolyline"
                                                  fill="none"
                                                  stroke="#1b6ec2"
                                                  stroke-width="3" />
                                        @foreach (var point in chartPoints)
                                        {
                                            <circle cx="@point.X" cy="@point.Y" r="4" fill="#4caf50">
                                                <title>@point.Tooltip</title>
                                            </circle>
                                        }
                                    </svg>
                                </div>
                                <div class="chart-axis">
                                    <span>@chartStartLabel</span>
                                    <span>@chartEndLabel</span>
                                </div>
                                <div class="axis-label axis-label-x">@chartXAxisLabel</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid UserId { get; set; }

    private const int PageSize = 20;
    private const int ChartWidth = 600;
    private const int ChartHeight = 200;

    private UserProfile? currentUser;
    private IReadOnlyList<ReadingResult> readingResults = Array.Empty<ReadingResult>();
    private IReadOnlyList<DurationResultItem> durationResults = Array.Empty<DurationResultItem>();
    private int currentPage = 1;
    private readonly List<ChartPoint> chartPoints = new();
    private string chartStartLabel = string.Empty;
    private string chartEndLabel = string.Empty;
    private readonly List<double> chartYAxisTicks = new();
    private string resultsDescription = string.Empty;
    private string chartTitle = string.Empty;
    private string chartSubtitle = string.Empty;
    private string chartYAxisLabel = string.Empty;
    private string chartXAxisLabel = "Oś X (pozioma): data rozgrywki";
    private ChartMetric chartMetric = ChartMetric.WordsPerMinute;

    private ResultsView selectedView = ResultsView.Reading;

    private ResultsView SelectedView
    {
        get => selectedView;
        set
        {
            if (selectedView == value)
            {
                return;
            }

            selectedView = value;
            LoadResults();
        }
    }

    private readonly IReadOnlyList<ResultOption> resultOptions = new List<ResultOption>
    {
        new(ResultsView.Reading, "Czytanie", "Statystyki gry Czytanie."),
        new(ResultsView.LiterkiArrange, "Literki - ustawianie", "Statystyki gry Literki (ustawianie)."),
        new(ResultsView.LiterkiGuess, "Literki - zgadywanie", "Statystyki gry Literki (zgadywanie)."),
        new(ResultsView.LiterkiFirstLetter, "Literki - pierwsza", "Statystyki gry Literki (pierwsza litera)."),
        new(ResultsView.MathPlusMinus, "Matematyka - plus i minus", "Statystyki gry Matematyka (plus i minus)."),
        new(ResultsView.MathArithmetic, "Matematyka - arytmetyka", "Statystyki gry Matematyka (arytmetyka).")
    };

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(CurrentResultsCount / (double)PageSize));

    private int CurrentResultsCount => SelectedView == ResultsView.Reading
        ? readingResults.Count
        : durationResults.Count;

    private IEnumerable<ReadingResult> PaginatedReadingResults =>
        readingResults.Skip((currentPage - 1) * PageSize).Take(PageSize);

    private IEnumerable<DurationResultItem> PaginatedDurationResults =>
        durationResults.Skip((currentPage - 1) * PageSize).Take(PageSize);

    private string ChartPolyline =>
        string.Join(" ", chartPoints.Select(point =>
            string.Format(CultureInfo.InvariantCulture, "{0:0},{1:0}", point.X, point.Y)));

    protected override void OnParametersSet()
    {
        currentUser = UserState.Users.FirstOrDefault(user => user.Id == UserId);
        LoadResults();
    }

    private void LoadResults()
    {
        readingResults = Array.Empty<ReadingResult>();
        durationResults = Array.Empty<DurationResultItem>();
        currentPage = 1;

        var option = resultOptions.FirstOrDefault(opt => opt.View == SelectedView) ?? resultOptions[0];
        resultsDescription = option.Description;

        if (currentUser is null)
        {
            BuildChart();
            return;
        }

        switch (SelectedView)
        {
            case ResultsView.Reading:
                readingResults = ResultsArchive.GetReadingResults(UserId);
                chartMetric = ChartMetric.WordsPerMinute;
                chartTitle = "Tempo czytania w czasie";
                chartSubtitle = "Obserwuj, czy tempo czytania rośnie wraz z kolejnymi grami.";
                chartYAxisLabel = "Oś Y (pionowa): słów na minutę";
                break;
            case ResultsView.LiterkiArrange:
                LoadDurationResults(ResultsArchive.GetLiterkiResults(UserId, LiterkiGameMode.Arrange));
                break;
            case ResultsView.LiterkiGuess:
                LoadDurationResults(ResultsArchive.GetLiterkiResults(UserId, LiterkiGameMode.Guess));
                break;
            case ResultsView.LiterkiFirstLetter:
                LoadDurationResults(ResultsArchive.GetLiterkiResults(UserId, LiterkiGameMode.FirstLetter));
                break;
            case ResultsView.MathPlusMinus:
                LoadDurationResults(ResultsArchive.GetMathResults(UserId, MathGameMode.PlusMinus));
                break;
            case ResultsView.MathArithmetic:
                LoadDurationResults(ResultsArchive.GetMathResults(UserId, MathGameMode.Arithmetic));
                break;
        }

        BuildChart();
    }

    private void LoadDurationResults(IEnumerable<LiterkiResult> results)
    {
        durationResults = results
            .Select(result => new DurationResultItem(result.PlayedAt, result.GameDurationSeconds))
            .ToList();
        ConfigureDurationChart();
    }

    private void LoadDurationResults(IEnumerable<MathResult> results)
    {
        durationResults = results
            .Select(result => new DurationResultItem(result.PlayedAt, result.GameDurationSeconds))
            .ToList();
        ConfigureDurationChart();
    }

    private void ConfigureDurationChart()
    {
        chartMetric = ChartMetric.DurationSeconds;
        chartTitle = "Czas rozwiązania w czasie";
        chartSubtitle = "Zobacz, czy czas rozwiązania skraca się wraz z kolejnymi rozgrywkami.";
        chartYAxisLabel = "Oś Y (pionowa): czas rozwiązania";
    }

    private void BuildChart()
    {
        chartPoints.Clear();
        chartYAxisTicks.Clear();
        chartStartLabel = string.Empty;
        chartEndLabel = string.Empty;

        var entries = SelectedView == ResultsView.Reading
            ? readingResults.Select(result => new ChartEntry(result.PlayedAt, result.WordsPerMinute,
                $"{result.PlayedAt:dd.MM.yyyy}: {Math.Round(result.WordsPerMinute)} sł/min"))
            : durationResults.Select(result => new ChartEntry(result.PlayedAt, result.DurationSeconds,
                $"{result.PlayedAt:dd.MM.yyyy}: {FormatDuration(TimeSpan.FromSeconds(result.DurationSeconds))}"));

        var orderedEntries = entries.OrderBy(entry => entry.PlayedAt).ToList();
        if (orderedEntries.Count == 0)
        {
            return;
        }

        var maxValue = orderedEntries.Max(entry => entry.Value);
        if (maxValue <= 0)
        {
            maxValue = 1;
        }

        var scaleStep = CalculateScaleStep(maxValue);
        var scaleMax = Math.Max(scaleStep, Math.Ceiling(maxValue / scaleStep) * scaleStep);
        for (var value = scaleMax; value >= 0; value -= scaleStep)
        {
            chartYAxisTicks.Add(value);
        }

        var step = orderedEntries.Count == 1 ? 0 : ChartWidth / (double)(orderedEntries.Count - 1);
        for (var index = 0; index < orderedEntries.Count; index++)
        {
            var entry = orderedEntries[index];
            var x = orderedEntries.Count == 1 ? ChartWidth / 2.0 : index * step;
            var y = ChartHeight - (entry.Value / scaleMax * ChartHeight);
            chartPoints.Add(new ChartPoint(x, y, entry.Value, entry.PlayedAt.ToString("dd.MM.yyyy"), entry.Tooltip));
        }

        chartStartLabel = orderedEntries.First().PlayedAt.ToString("dd.MM.yyyy");
        chartEndLabel = orderedEntries.Last().PlayedAt.ToString("dd.MM.yyyy");
    }

    private static int CalculateScaleStep(double maxValue)
    {
        if (maxValue <= 0)
        {
            return 1;
        }

        var roughStep = maxValue / 4;
        if (roughStep <= 0)
        {
            return 1;
        }

        var magnitude = Math.Pow(10, Math.Floor(Math.Log10(roughStep)));
        var normalized = roughStep / magnitude;
        var niceNormalized = normalized switch
        {
            <= 1 => 1,
            <= 2 => 2,
            <= 5 => 5,
            _ => 10
        };

        return (int)Math.Max(1, niceNormalized * magnitude);
    }

    private string FormatYAxisTick(double value)
    {
        return chartMetric == ChartMetric.DurationSeconds
            ? FormatDuration(TimeSpan.FromSeconds(value))
            : value.ToString("0", CultureInfo.InvariantCulture);
    }

    private string FormatDuration(TimeSpan duration)
    {
        return duration.TotalHours >= 1
            ? duration.ToString(@"hh\:mm\:ss")
            : duration.ToString(@"mm\:ss");
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (currentPage < TotalPages)
        {
            currentPage++;
        }
    }

    private void Close()
    {
        Navigation.NavigateTo("/");
    }

    private sealed record ChartPoint(double X, double Y, double Value, string Label, string Tooltip);

    private sealed record ChartEntry(DateTime PlayedAt, double Value, string Tooltip);

    private sealed record DurationResultItem(DateTime PlayedAt, int DurationSeconds);

    private sealed record ResultOption(ResultsView View, string Label, string Description);

    private enum ResultsView
    {
        Reading,
        LiterkiArrange,
        LiterkiGuess,
        LiterkiFirstLetter,
        MathPlusMinus,
        MathArithmetic
    }

    private enum ChartMetric
    {
        WordsPerMinute,
        DurationSeconds
    }
}
