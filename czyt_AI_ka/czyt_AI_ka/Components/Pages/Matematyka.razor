@page "/matematyka"
@using System.Timers
@using czyt_AI_ka.Components.Backend
@using czyt_AI_ka.Components.Backend.Models
@inject UserState UserState
@inject ResultsArchive ResultsArchive
@implements IDisposable

<div class="app-screen app-screen-matematyka">
    <div class="app-card math-card">
        @if (selectedGame is null)
        {
            <div class="math-selection">
                <h2 class="math-selection-title">Matematyka</h2>
                <p class="math-selection-subtitle">Wybierz tryb gry i rozpocznij ćwiczenia.</p>

                <div class="math-games-grid">
                    <button class="math-game-tile" @onclick="() => SelectGame(MathGame.PlusMinus)">
                        <img class="math-game-image" src="images/games/math-plus-minus.svg" alt="Gra Plus i Minus" />
                        <div class="math-game-content">
                            <h3>Plus i Minus</h3>
                            <p>Dodawanie i odejmowanie z zakresu 1-100. Wpisuj poprawne wyniki.</p>
                        </div>
                    </button>
                    <button class="math-game-tile" @onclick="() => SelectGame(MathGame.Arithmetic)">
                        <img class="math-game-image" src="images/games/math-plus-minus.svg" alt="Gra Arytmetyka" />
                        <div class="math-game-content">
                            <h3>Arytmetyka</h3>
                            <p>Rozwiązuj krótkie wyrażenia z dodawaniem i odejmowaniem.</p>
                        </div>
                    </button>
                    <button class="math-game-tile" @onclick="() => SelectGame(MathGame.Multiplication)">
                        <img class="math-game-image" src="images/games/math-plus-minus.svg" alt="Gra Mnożenie" />
                        <div class="math-game-content">
                            <h3>Mnożenie</h3>
                            <p>Rozłóż mnożenie na dodawanie i podaj prawidłowy wynik.</p>
                        </div>
                    </button>
                </div>
            </div>
        }
        else if (currentScreen == MathScreen.Setup)
        {
            <div class="math-setup text-center">
                <h2>@SelectedGameTitle</h2>
                <p>@SelectedGameDescription</p>

                @if (selectedGame != MathGame.Multiplication)
                {
                    <div class="math-range-options">
                        @foreach (var option in rangeOptions)
                        {
                            <label class="math-range-option">
                                <input type="radio"
                                       name="mathRange"
                                       value="@option.Max"
                                       checked="@(selectedMax == option.Max)"
                                       @onchange="() => selectedMax = option.Max" />
                                <span>@option.Label</span>
                            </label>
                        }
                    </div>
                }

                <div class="math-setup-actions">
                    <button class="btn btn-primary btn-lg" @onclick="StartGame">Zaczynamy</button>
                    <button class="btn btn-outline-secondary btn-lg" @onclick="BackToSelection">Powrót</button>
                </div>
            </div>
        }
        else if (currentScreen == MathScreen.Play)
        {
            <div class="math-play">
                <div class="math-info">
                    <span>⏱ @elapsedTime.ToString(@"mm\:ss")</span>
                    <span>✅ @CorrectCount / @TotalTasks</span>
                </div>

                <div class="math-task-board @(selectedGame is MathGame.Multiplication or MathGame.Arithmetic ? "math-task-board-single" : string.Empty)">
                    @if (selectedGame == MathGame.PlusMinus)
                    {
                        <div class="math-column">
                            <h3>Odejmowanie</h3>
                            @foreach (var task in subtractionTasks)
                            {
                                <div class="math-task">
                                    <div class="math-equation">@task.Left - @task.Right =</div>
                                    <input class="math-input @GetInputClass(task)"
                                           type="number"
                                           inputmode="numeric"
                                           value="@task.Input"
                                           @oninput="(e) => OnAnswerInput(task, e)"
                                           disabled="@isGameCompleted" />
                                </div>
                            }
                        </div>

                        <div class="math-column">
                            <h3>Dodawanie</h3>
                            @foreach (var task in additionTasks)
                            {
                                <div class="math-task">
                                    <div class="math-equation">@task.Left + @task.Right =</div>
                                    <input class="math-input @GetInputClass(task)"
                                           type="number"
                                           inputmode="numeric"
                                           value="@task.Input"
                                           @oninput="(e) => OnAnswerInput(task, e)"
                                           disabled="@isGameCompleted" />
                                </div>
                            }
                        </div>
                    }
                    else if (selectedGame == MathGame.Arithmetic)
                    {
                        <div class="math-column">
                            <h3>Wyrażenia</h3>
                            @foreach (var task in arithmeticTasks)
                            {
                                <div class="math-task">
                                    <div class="math-equation">@task.Expression =</div>
                                    <input class="math-input @GetInputClass(task)"
                                           type="number"
                                           inputmode="numeric"
                                           value="@task.Input"
                                           @oninput="(e) => OnAnswerInput(task, e)"
                                           disabled="@isGameCompleted" />
                                </div>
                            }
                        </div>
                    }
                    else if (selectedGame == MathGame.Multiplication)
                    {
                        <div class="math-column">
                            <h3>Mnożenie</h3>
                            @foreach (var task in multiplicationTasks)
                            {
                                <div class="math-task math-task-multiplication">
                                    <div class="math-equation">@task.Left × @task.Right =</div>
                                    <input class="math-input math-input-wide @GetAdditionInputClass(task)"
                                           type="text"
                                           inputmode="text"
                                           value="@task.AdditionInput"
                                           placeholder="np. 3+3+3"
                                           @oninput="(e) => OnAdditionInput(task, e)"
                                           disabled="@isGameCompleted" />
                                    <span class="math-equals">=</span>
                                    <input class="math-input @GetResultInputClass(task)"
                                           type="number"
                                           inputmode="numeric"
                                           value="@task.Input"
                                           @oninput="(e) => OnResultInput(task, e)"
                                           disabled="@isGameCompleted" />
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else if (currentScreen == MathScreen.Summary)
        {
            <div class="czytanie-form">
                <div class="summary-container text-center">
                    <h2>Gratulacje! 🎉</h2>
                    <p class="summary-text">
                        Ukończyłeś/aś wszystkie zadania z gry @SelectedGameTitle.
                    </p>
                    <p class="summary-text">
                        Twój czas: <strong>@elapsedTime.ToString(@"mm\:ss")</strong> &middot;
                        Poprawne odpowiedzi: <strong>@TotalTasks / @TotalTasks</strong>
                    </p>
                    <button class="btn btn-primary mt-3" @onclick="RestartGame">Jeszcze raz?</button>

                    <div class="celebration-layer">
                        <div class="balloons">
                            <span class="balloon balloon-1">🎈</span>
                            <span class="balloon balloon-2">🎈</span>
                            <span class="balloon balloon-3">🎈</span>
                        </div>
                        <div class="confetti">
                            <span class="confetti-piece confetti-1">🎉</span>
                            <span class="confetti-piece confetti-2">✨</span>
                            <span class="confetti-piece confetti-3">🎊</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private enum MathGame
    {
        PlusMinus,
        Arithmetic,
        Multiplication
    }

    private enum MathScreen
    {
        Setup,
        Play,
        Summary
    }

    private sealed record RangeOption(string Label, int Max);

    private interface IAnswerTask
    {
        string Input { get; set; }
        bool IsCorrect { get; }
    }

    private sealed class MathTask : IAnswerTask
    {
        public int Left { get; init; }
        public int Right { get; init; }
        public char Operator { get; init; }
        public string Input { get; set; } = string.Empty;

        public int Answer => Operator == '+' ? Left + Right : Left - Right;

        public bool IsCorrect
        {
            get
            {
                if (int.TryParse(Input, out var value))
                {
                    return value == Answer;
                }

                return false;
            }
        }
    }

    private sealed class ArithmeticTask : IAnswerTask
    {
        public IReadOnlyList<int> Terms { get; }
        public IReadOnlyList<char> Operators { get; }
        public string Input { get; set; } = string.Empty;

        public ArithmeticTask(IReadOnlyList<int> terms, IReadOnlyList<char> operators)
        {
            Terms = terms;
            Operators = operators;
        }

        public int Answer
        {
            get
            {
                var total = Terms[0];

                for (var i = 1; i < Terms.Count; i++)
                {
                    total = Operators[i - 1] == '+' ? total + Terms[i] : total - Terms[i];
                }

                return total;
            }
        }

        public string Expression
        {
            get
            {
                var parts = new List<string> { Terms[0].ToString() };

                for (var i = 1; i < Terms.Count; i++)
                {
                    parts.Add(Operators[i - 1].ToString());
                    parts.Add(Terms[i].ToString());
                }

                return string.Join(" ", parts);
            }
        }

        public bool IsCorrect
        {
            get
            {
                if (int.TryParse(Input, out var value))
                {
                    return value == Answer;
                }

                return false;
            }
        }
    }

    private sealed class MultiplicationTask : IAnswerTask
    {
        public int Left { get; init; }
        public int Right { get; init; }
        public string AdditionInput { get; set; } = string.Empty;
        public string Input { get; set; } = string.Empty;

        public int Answer => Left * Right;

        public bool IsAdditionCorrect => IsAdditionExpressionValid(AdditionInput);

        public bool IsCorrect => IsAdditionCorrect && IsResultCorrect;

        public bool IsResultCorrect
        {
            get
            {
                if (int.TryParse(Input, out var value))
                {
                    return value == Answer;
                }

                return false;
            }
        }

        private bool IsAdditionExpressionValid(string input)
        {
            if (string.IsNullOrWhiteSpace(input))
            {
                return false;
            }

            var parts = input.Split('+', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length == 0)
            {
                return false;
            }

            var values = new List<int>(parts.Length);
            foreach (var part in parts)
            {
                if (!int.TryParse(part.Trim(), out var value))
                {
                    return false;
                }

                values.Add(value);
            }

            var count = values.Count;
            var matchesLeft = count == Left && values.All(value => value == Right);
            var matchesRight = count == Right && values.All(value => value == Left);

            if (Left == 0 && Right == 0)
            {
                return values.All(value => value == 0);
            }

            return matchesLeft || matchesRight;
        }
    }

    private readonly List<RangeOption> rangeOptions = new()
    {
        new RangeOption("1-10", 10),
        new RangeOption("1-20", 20),
        new RangeOption("1-100", 100)
    };

    private MathGame? selectedGame;
    private MathScreen currentScreen = MathScreen.Setup;
    private int selectedMax = 10;

    private const int MinRange = 1;
    private const int MultiplicationMin = 1;
    private const int MultiplicationMax = 9;
    private List<MathTask> additionTasks = new();
    private List<MathTask> subtractionTasks = new();
    private List<ArithmeticTask> arithmeticTasks = new();
    private List<MultiplicationTask> multiplicationTasks = new();

    private DateTime? gameStartTime;
    private TimeSpan elapsedTime = TimeSpan.Zero;
    private Timer? gameTimer;
    private bool isGameCompleted;
    private bool hasSavedResult;

    private int TotalTasks => CurrentTasks.Count();
    private int CorrectCount => CurrentTasks.Count(task => task.IsCorrect);

    private IEnumerable<IAnswerTask> CurrentTasks => selectedGame switch
    {
        MathGame.PlusMinus => additionTasks.Concat(subtractionTasks),
        MathGame.Arithmetic => arithmeticTasks,
        MathGame.Multiplication => multiplicationTasks,
        _ => Enumerable.Empty<IAnswerTask>()
    };

    private string SelectedGameTitle => selectedGame switch
    {
        MathGame.Arithmetic => "Arytmetyka",
        MathGame.Multiplication => "Mnożenie",
        _ => "Plus i Minus"
    };

    private string SelectedGameDescription => selectedGame switch
    {
        MathGame.Arithmetic => "Rozwiązuj wyrażenia z 6 liczbami, aby odnaleźć prawidłowy wynik.",
        MathGame.Multiplication => "Rozłóż mnożenie na dodawanie i podaj prawidłowy wynik (liczby 1-9).",
        _ => "Wybierz zakres liczb, aby rozpocząć rozwiązywanie zadań."
    };

    private void SelectGame(MathGame game)
    {
        selectedGame = game;
        currentScreen = MathScreen.Setup;
        ResetGameState();
    }

    private void BackToSelection()
    {
        StopTimer();
        selectedGame = null;
        ResetGameState();
    }

    private void StartGame()
    {
        GenerateTasks();
        elapsedTime = TimeSpan.Zero;
        isGameCompleted = false;
        hasSavedResult = false;
        currentScreen = MathScreen.Play;
        StartTimer();
    }

    private void RestartGame()
    {
        StopTimer();
        ResetGameState();
        currentScreen = MathScreen.Setup;
    }

    private void ResetGameState()
    {
        additionTasks = new List<MathTask>();
        subtractionTasks = new List<MathTask>();
        arithmeticTasks = new List<ArithmeticTask>();
        multiplicationTasks = new List<MultiplicationTask>();
        elapsedTime = TimeSpan.Zero;
        isGameCompleted = false;
        gameStartTime = null;
        hasSavedResult = false;
    }

    private void GenerateTasks()
    {
        var random = new Random();

        additionTasks = new List<MathTask>();
        subtractionTasks = new List<MathTask>();
        arithmeticTasks = new List<ArithmeticTask>();
        multiplicationTasks = new List<MultiplicationTask>();

        if (selectedGame == MathGame.PlusMinus)
        {
            additionTasks = Enumerable.Range(0, 5)
                .Select(_ => CreateAdditionTask(random))
                .ToList();

            subtractionTasks = Enumerable.Range(0, 5)
                .Select(_ => CreateSubtractionTask(random))
                .ToList();
        }
        else if (selectedGame == MathGame.Arithmetic)
        {
            arithmeticTasks = Enumerable.Range(0, 5)
                .Select(_ => CreateArithmeticTask(random))
                .ToList();
        }
        else if (selectedGame == MathGame.Multiplication)
        {
            multiplicationTasks = Enumerable.Range(0, 5)
                .Select(_ => CreateMultiplicationTask(random))
                .ToList();
        }
    }

    private MathTask CreateAdditionTask(Random random)
    {
        var left = random.Next(MinRange, selectedMax + 1);
        var right = random.Next(MinRange, selectedMax + 1);

        return new MathTask
        {
            Left = left,
            Right = right,
            Operator = '+'
        };
    }

    private MathTask CreateSubtractionTask(Random random)
    {
        var left = random.Next(MinRange, selectedMax + 1);
        var right = random.Next(MinRange, selectedMax + 1);

        if (right > left)
        {
            (left, right) = (right, left);
        }

        return new MathTask
        {
            Left = left,
            Right = right,
            Operator = '-'
        };
    }

    private ArithmeticTask CreateArithmeticTask(Random random)
    {
        var terms = new List<int>(6)
        {
            random.Next(MinRange, selectedMax + 1)
        };

        var operators = new List<char>(5);
        var current = terms[0];

        for (var i = 1; i < 6; i++)
        {
            var next = random.Next(MinRange, selectedMax + 1);
            var op = random.Next(0, 2) == 0 ? '+' : '-';

            if (op == '-' && current - next < 0)
            {
                op = '+';
            }

            operators.Add(op);
            current = op == '+' ? current + next : current - next;
            terms.Add(next);
        }

        return new ArithmeticTask(terms, operators);
    }

    private MultiplicationTask CreateMultiplicationTask(Random random)
    {
        var left = random.Next(MultiplicationMin, MultiplicationMax + 1);
        var right = random.Next(MultiplicationMin, MultiplicationMax + 1);

        return new MultiplicationTask
        {
            Left = left,
            Right = right
        };
    }

    private async Task OnAnswerInput(IAnswerTask task, ChangeEventArgs args)
    {
        if (isGameCompleted)
        {
            return;
        }

        task.Input = args.Value?.ToString()?.Trim() ?? string.Empty;

        await EvaluateCompletionAsync();
    }

    private async Task OnAdditionInput(MultiplicationTask task, ChangeEventArgs args)
    {
        if (isGameCompleted)
        {
            return;
        }

        task.AdditionInput = args.Value?.ToString()?.Trim() ?? string.Empty;
        await EvaluateCompletionAsync();
    }

    private async Task OnResultInput(MultiplicationTask task, ChangeEventArgs args)
    {
        if (isGameCompleted)
        {
            return;
        }

        task.Input = args.Value?.ToString()?.Trim() ?? string.Empty;
        await EvaluateCompletionAsync();
    }

    private string GetInputClass(IAnswerTask task)
    {
        if (string.IsNullOrWhiteSpace(task.Input))
        {
            return string.Empty;
        }

        return task.IsCorrect ? "correct" : "incorrect";
    }

    private string GetAdditionInputClass(MultiplicationTask task)
    {
        if (string.IsNullOrWhiteSpace(task.AdditionInput))
        {
            return string.Empty;
        }

        return task.IsAdditionCorrect ? "correct" : "incorrect";
    }

    private string GetResultInputClass(MultiplicationTask task)
    {
        if (string.IsNullOrWhiteSpace(task.Input))
        {
            return string.Empty;
        }

        return task.IsResultCorrect ? "correct" : "incorrect";
    }

    private async Task EvaluateCompletionAsync()
    {
        if (TotalTasks > 0 && CurrentTasks.All(t => t.IsCorrect))
        {
            isGameCompleted = true;
            if (gameStartTime.HasValue)
            {
                elapsedTime = DateTime.Now - gameStartTime.Value;
            }
            StopTimer();
            SaveResultIfNeeded();
            await Task.Delay(2000);
            currentScreen = MathScreen.Summary;
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartTimer()
    {
        StopTimer();
        gameStartTime = DateTime.Now;
        gameTimer = new Timer(200);
        gameTimer.Elapsed += (_, _) =>
        {
            if (gameStartTime.HasValue)
            {
                elapsedTime = DateTime.Now - gameStartTime.Value;
                InvokeAsync(StateHasChanged);
            }
        };
        gameTimer.Start();
    }

    private void StopTimer()
    {
        if (gameTimer is null)
        {
            return;
        }

        gameTimer.Stop();
        gameTimer.Dispose();
        gameTimer = null;
    }

    private void SaveResultIfNeeded()
    {
        if (hasSavedResult || UserState.SelectedUser is null || selectedGame is null)
        {
            return;
        }

        var result = new MathResult
        {
            UserId = UserState.SelectedUser.Id,
            PlayerName = UserState.SelectedUser.Name,
            PlayedAt = DateTime.Now,
            GameDurationSeconds = (int)Math.Round(elapsedTime.TotalSeconds),
            Mode = selectedGame switch
            {
                MathGame.Arithmetic => MathGameMode.Arithmetic,
                MathGame.Multiplication => MathGameMode.Multiplication,
                _ => MathGameMode.PlusMinus
            }
        };

        ResultsArchive.AddMathResult(result);
        hasSavedResult = true;
    }

    public void Dispose()
    {
        StopTimer();
    }
}
