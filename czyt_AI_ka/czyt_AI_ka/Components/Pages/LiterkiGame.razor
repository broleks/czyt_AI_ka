@page "/literki"
@using System.Timers
@implements IDisposable

<div class="app-screen app-screen-literaki">
    <div class="app-card literaki-card">
        @if (currentScreen == GameScreen.Draw)
        {
            <div class="literaki-form text-center">
                <h2>Układanka z literek</h2>
                <p>Wylosuj obrazek i ułóż właściwe słowo z liter.</p>

                <div class="literaki-options">
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="caseLower" name="letterCase" value="lower" @onchange="() => caseOption = LetterCase.Lower" checked="@(caseOption == LetterCase.Lower)" />
                        <label class="form-check-label" for="caseLower">Małe litery</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" id="caseUpper" name="letterCase" value="upper" @onchange="() => caseOption = LetterCase.Upper" checked="@(caseOption == LetterCase.Upper)" />
                        <label class="form-check-label" for="caseUpper">Duże litery</label>
                    </div>
                </div>

                <button class="btn btn-primary btn-lg" @onclick="StartDraw" disabled="@isDrawing">
                    @((isDrawing ? "Losowanie..." : "Losuj słowo"))
                </button>

                <div class="literaki-carousel">
                    <div class="carousel-window">
                        @if (currentPreview is null)
                        {
                            <div class="carousel-placeholder">Kliknij "Losuj słowo", aby rozpocząć.</div>
                        }
                        else
                        {
                            <img class="carousel-image @(isDrawing ? "carousel-anim" : string.Empty)"
                                 src="@GetImagePath(currentPreview)"
                                 alt="Wylosowany obrazek" />
                            <div class="carousel-word">@GetDisplayWord(currentPreview.Word)</div>
                        }
                    </div>
                </div>

                @if (showPlayButton)
                {
                    <div class="literaki-play-actions">
                        <button class="btn btn-success btn-lg" @onclick="() => StartGame(GameMode.Arrange)">
                            Graj ustawianie
                        </button>
                        <button class="btn btn-warning btn-lg" @onclick="() => StartGame(GameMode.Guess)">
                            Graj zgadywanie
                        </button>
                        <button class="btn btn-info btn-lg" @onclick="() => StartGame(GameMode.FirstLetter)">
                            Graj pierwsza
                        </button>
                    </div>
                }
            </div>
        }
        else if (currentScreen == GameScreen.Play && selectedWord is not null)
        {
            <div class="literaki-form literaki-game">
                <div class="literaki-image">
                    <img src="@GetImagePath(selectedWord)" alt="Obrazek do ułożenia słowa" />
                </div>

                <div class="literaki-info">
                    <span>⏱ @elapsedTime.ToString(@"mm\:ss")</span>
                    <span>🔤 Liczba liter: @letters.Count</span>
                </div>

                @if (currentMode == GameMode.Arrange)
                {
                    <div class="letters-row">
                        @for (var i = 0; i < letters.Count; i++)
                        {
                            var index = i;
                            <div class="letter-slot">
                                <button class="letter-btn @(selectedIndex == index ? "selected" : string.Empty) @(focusedIndex == index ? "focused" : string.Empty) @(isCompleted ? "completed" : string.Empty)"
                                        @onclick="() => OnLetterClicked(index)">
                                    @GetDisplayLetter(letters[index])
                                </button>
                                <div class="letter-move">
                                    <button class="move-btn" @onclick="() => MoveLeft(index)" disabled="@(isCompleted || index == 0)">◀</button>
                                    <button class="move-btn" @onclick="() => MoveRight(index)" disabled="@(isCompleted || index == letters.Count - 1)">▶</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (currentMode == GameMode.Guess && missingIndex.HasValue)
                {
                    <div class="letters-row">
                        @for (var i = 0; i < selectedWord.Word.Length; i++)
                        {
                            <div class="letter-slot">
                                @if (i == missingIndex.Value)
                                {
                                    <input class="letter-btn letter-input @(isCompleted ? "completed" : string.Empty)"
                                           value="@guessInput"
                                           maxlength="1"
                                           aria-label="Wpisz brakującą literę"
                                           @oninput="OnGuessInput"
                                           disabled="@(isCompleted)" />
                                }
                                else
                                {
                                    <button class="letter-btn @(isCompleted ? "completed" : string.Empty)" disabled>
                                        @GetDisplayLetter(selectedWord.Word[i])
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="keyboard-hint">
                        Wpisz brakującą literę z klawiatury.
                    </div>
                }
                else if (currentMode == GameMode.FirstLetter && firstLetterOptions.Count == 4)
                {
                    <div class="letters-row first-letter-options">
                        @for (var i = 0; i < firstLetterOptions.Count; i++)
                        {
                            var index = i;
                            <button class="letter-btn @GetFirstLetterButtonClass(index)"
                                    @onclick="() => OnFirstLetterSelected(index)"
                                    disabled="@(isCompleted)">
                                @GetDisplayLetter(firstLetterOptions[index])
                            </button>
                        }
                    </div>
                    <div class="keyboard-hint">
                        Wybierz pierwszą literę słowa.
                    </div>
                }
            </div>
        }
        else if (currentScreen == GameScreen.Summary && selectedWord is not null)
        {
            <div class="czytanie-form">
                <div class="summary-container text-center">
                    <h2>Gratulacje! 🎉</h2>
                    <p class="summary-text">
                        Udało Ci się ułożyć słowo <strong>@GetDisplayWord(selectedWord.Word)</strong>.
                    </p>
                    <p class="summary-text">
                        Twój czas: <strong>@elapsedTime.ToString(@"mm\:ss")</strong> &middot;
                        Liczba liter: <strong>@selectedWord.Word.Length</strong>
                    </p>
                    <button class="btn btn-primary mt-3" @onclick="RestartProcess">
                        Jeszcze raz?
                    </button>

                    <div class="celebration-layer">
                        <div class="balloons">
                            <span class="balloon balloon-1">🎈</span>
                            <span class="balloon balloon-2">🎈</span>
                            <span class="balloon balloon-3">🎈</span>
                        </div>
                        <div class="confetti">
                            <span class="confetti-piece confetti-1">🎉</span>
                            <span class="confetti-piece confetti-2">✨</span>
                            <span class="confetti-piece confetti-3">🎊</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private readonly List<WordEntry> wordEntries = new()
    {
        new("boisko"),
        new("buja"),
        new("buty"),
        new("delfin"),
        new("dom"),
        new("hulajnoga"),
        new("kaczka"),
        new("klocki"),
        new("koparka"),
        new("kot"),
        new("koza"),
        new("krowa"),
        new("kuchnia"),
        new("kura"),
        new("kwiaty"),
        new("lalka"),
        new("lis"),
        new("miś"),
        new("motyl"),
        new("mysz"),
        new("obiad"),
        new("ogród"),
        new("owca"),
        new("pies"),
        new("piłka"),
        new("plaża"),
        new("pociąg"),
        new("prezent"),
        new("ptak"),
        new("rakieta"),
        new("rekin"),
        new("rower"),
        new("ryba"),
        new("rysuje"),
        new("sarenka"),
        new("skaczą"),
        new("słoń"),
        new("szkoła"),
        new("układa"),
        new("wyspa"),
        new("zając"),
        new("zebra"),
        new("żaba")
    };

    private GameScreen currentScreen = GameScreen.Draw;
    private WordEntry? currentPreview;
    private WordEntry? selectedWord;
    private bool isDrawing;
    private bool showPlayButton;
    private List<char> letters = new();
    private int focusedIndex;
    private int? selectedIndex;
    private int? missingIndex;
    private string guessInput = string.Empty;
    private TimeSpan elapsedTime = TimeSpan.Zero;
    private DateTime gameStartTime;
    private Timer? gameTimer;
    private bool isCompleted;
    private LetterCase caseOption = LetterCase.Lower;
    private GameMode currentMode = GameMode.Arrange;
    private List<char> firstLetterOptions = new();
    private int? firstLetterCorrectIndex;
    private HashSet<int> firstLetterWrongIndexes = new();

    private async Task StartDraw()
    {
        if (isDrawing)
        {
            return;
        }

        isDrawing = true;
        showPlayButton = false;
        selectedWord = null;
        var random = new Random();

        for (var i = 0; i < 20; i++)
        {
            currentPreview = wordEntries[random.Next(wordEntries.Count)];
            await InvokeAsync(StateHasChanged);
            await Task.Delay(120);
        }

        selectedWord = currentPreview;
        isDrawing = false;
        showPlayButton = true;
    }

    private void StartGame(GameMode mode)
    {
        if (selectedWord is null)
        {
            return;
        }

        currentMode = mode;
        currentScreen = GameScreen.Play;
        if (currentMode == GameMode.Arrange)
        {
            PrepareLetters();
        }
        else if (currentMode == GameMode.Guess)
        {
            PrepareGuess();
        }
        else
        {
            PrepareFirstLetter();
        }
        StartTimer();
    }

    private void PrepareLetters()
    {
        if (selectedWord is null)
        {
            return;
        }

        var random = new Random();
        letters = selectedWord.Word.ToCharArray().OrderBy(_ => random.Next()).ToList();

        if (string.Equals(new string(letters.ToArray()), selectedWord.Word, StringComparison.OrdinalIgnoreCase))
        {
            letters.Reverse();
        }

        focusedIndex = 0;
        selectedIndex = null;
        isCompleted = false;
        missingIndex = null;
        guessInput = string.Empty;
    }

    private void PrepareGuess()
    {
        if (selectedWord is null)
        {
            return;
        }

        var random = new Random();
        letters = selectedWord.Word.ToCharArray().ToList();
        missingIndex = random.Next(selectedWord.Word.Length);
        guessInput = string.Empty;
        isCompleted = false;
        selectedIndex = null;
        focusedIndex = 0;
    }

    private void PrepareFirstLetter()
    {
        if (selectedWord is null)
        {
            return;
        }

        var random = new Random();
        var correctLetter = char.ToLowerInvariant(selectedWord.Word[0]);
        var options = new HashSet<char> { correctLetter };
        var availableLetters = wordEntries
            .SelectMany(entry => entry.Word)
            .Select(char.ToLowerInvariant)
            .Distinct()
            .ToList();

        while (options.Count < 4 && availableLetters.Count > 0)
        {
            var candidate = availableLetters[random.Next(availableLetters.Count)];
            options.Add(candidate);
        }

        firstLetterOptions = options.OrderBy(_ => random.Next()).ToList();
        firstLetterCorrectIndex = firstLetterOptions.FindIndex(letter => char.ToLowerInvariant(letter) == correctLetter);
        firstLetterWrongIndexes = new HashSet<int>();

        letters = selectedWord.Word.ToCharArray().ToList();
        missingIndex = null;
        guessInput = string.Empty;
        isCompleted = false;
        selectedIndex = null;
        focusedIndex = 0;
    }

    private void StartTimer()
    {
        elapsedTime = TimeSpan.Zero;
        gameStartTime = DateTime.UtcNow;
        gameTimer?.Stop();
        gameTimer?.Dispose();

        gameTimer = new Timer(1000);
        gameTimer.Elapsed += OnTimerElapsed;
        gameTimer.AutoReset = true;
        gameTimer.Start();
    }

    private void OnTimerElapsed(object? sender, ElapsedEventArgs args)
    {
        elapsedTime = DateTime.UtcNow - gameStartTime;
        InvokeAsync(StateHasChanged);
    }

    private void OnLetterClicked(int index)
    {
        focusedIndex = index;
        selectedIndex = selectedIndex == index ? null : index;
    }

    private async Task MoveLeft(int index)
    {
        await MoveLetter(index, index - 1);
    }

    private async Task MoveRight(int index)
    {
        await MoveLetter(index, index + 1);
    }

    private async Task MoveLetter(int fromIndex, int toIndex)
    {
        if (fromIndex < 0 || fromIndex >= letters.Count || toIndex < 0 || toIndex >= letters.Count)
        {
            return;
        }

        if (fromIndex == toIndex)
        {
            return;
        }

        var letter = letters[fromIndex];
        letters.RemoveAt(fromIndex);
        letters.Insert(toIndex, letter);

        focusedIndex = toIndex;
        if (selectedIndex.HasValue)
        {
            selectedIndex = AdjustIndexForMove(selectedIndex.Value, fromIndex, toIndex);
        }

        await CheckCompletion();
    }

    private static int AdjustIndexForMove(int index, int fromIndex, int toIndex)
    {
        if (index == fromIndex)
        {
            return toIndex;
        }

        if (fromIndex < toIndex)
        {
            return index > fromIndex && index <= toIndex ? index - 1 : index;
        }

        return index >= toIndex && index < fromIndex ? index + 1 : index;
    }

    private async Task CheckCompletion()
    {
        if (selectedWord is null || isCompleted)
        {
            return;
        }

        var currentWord = new string(letters.ToArray());
        if (string.Equals(currentWord, selectedWord.Word, StringComparison.OrdinalIgnoreCase))
        {
            await FinishGame();
        }
    }

    private async Task CheckGuessCompletion()
    {
        if (selectedWord is null || isCompleted || !missingIndex.HasValue)
        {
            return;
        }

        var targetLetter = selectedWord.Word[missingIndex.Value].ToString();
        if (string.Equals(guessInput, targetLetter, StringComparison.OrdinalIgnoreCase))
        {
            guessInput = GetDisplayLetter(selectedWord.Word[missingIndex.Value]);
            await FinishGame();
        }
    }

    private async Task OnGuessInput(ChangeEventArgs args)
    {
        var rawValue = args.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(rawValue))
        {
            guessInput = string.Empty;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var trimmed = rawValue.Trim();
        var letter = trimmed.Length > 0 ? trimmed[0].ToString() : string.Empty;
        guessInput = ApplyCase(letter);
        await CheckGuessCompletion();
    }

    private async Task OnFirstLetterSelected(int index)
    {
        if (isCompleted || !firstLetterCorrectIndex.HasValue)
        {
            return;
        }

        if (index == firstLetterCorrectIndex.Value)
        {
            await FinishGame();
            return;
        }

        firstLetterWrongIndexes.Add(index);
    }

    private async Task FinishGame()
    {
        elapsedTime = DateTime.UtcNow - gameStartTime;
        gameTimer?.Stop();
        gameTimer?.Dispose();
        isCompleted = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2000);
        currentScreen = GameScreen.Summary;
        showPlayButton = false;
    }

    private void RestartProcess()
    {
        gameTimer?.Stop();
        gameTimer?.Dispose();
        currentScreen = GameScreen.Draw;
        showPlayButton = false;
        isDrawing = false;
        currentPreview = null;
        selectedWord = null;
        letters = new List<char>();
        isCompleted = false;
        elapsedTime = TimeSpan.Zero;
        missingIndex = null;
        guessInput = string.Empty;
        currentMode = GameMode.Arrange;
        firstLetterOptions = new List<char>();
        firstLetterCorrectIndex = null;
        firstLetterWrongIndexes = new HashSet<int>();
    }

    private string GetImagePath(WordEntry entry) => $"images/literaki/{entry.Word}.png";

    private string GetDisplayLetter(char letter)
        => caseOption == LetterCase.Upper ? char.ToUpper(letter).ToString() : char.ToLower(letter).ToString();

    private string GetDisplayWord(string word)
        => caseOption == LetterCase.Upper ? word.ToUpperInvariant() : word.ToLowerInvariant();

    private string ApplyCase(string letter)
        => caseOption == LetterCase.Upper ? letter.ToUpperInvariant() : letter.ToLowerInvariant();

    private string GetFirstLetterButtonClass(int index)
    {
        if (firstLetterCorrectIndex.HasValue && isCompleted && index == firstLetterCorrectIndex.Value)
        {
            return "correct";
        }

        return firstLetterWrongIndexes.Contains(index) ? "incorrect" : string.Empty;
    }

    private sealed record WordEntry(string Word);

    private enum GameScreen
    {
        Draw,
        Play,
        Summary
    }

    private enum GameMode
    {
        Arrange,
        Guess,
        FirstLetter
    }

    private enum LetterCase
    {
        Lower,
        Upper
    }

    public void Dispose()
    {
        gameTimer?.Stop();
        gameTimer?.Dispose();
    }
}
